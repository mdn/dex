{
  "name": "@mdn/dex-cloud-server",
  "version": "0.0.1",
  "description": "MDN's HTTP request handler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdn/dex.git",
    "directory": "cloud-function"
  },
  "license": "MPL-2.0",
  "author": "MDN Web Docs",
  "type": "module",
  "exports": {
    ".": "./src/app.js"
  },
  "main": "src/index.js",
  "bin": {
    "dex-cloud-server": "bin/dex-cloud-server.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build-canonicals": "node src/build-canonicals.js",
    "build-redirects": "node src/build-redirects.js",
    "check": "tsc --noEmit",
    "proxy": "node src/proxy.js",
    "server": "functions-framework --target=mdnHandler --ignored-routes \"\"",
    "server:watch": "nodemon --exec npm run server",
    "start": "nf start"
  },
  "nodemonConfig": {
    "ext": "json,js",
    "watch": [
      ".env",
      "src"
    ]
  },
  "dependencies": {
    "@adzerk/decision-sdk": "^1.0.0-beta.30",
    "@google-cloud/functions-framework": "^5.0.5",
    "@sentry/google-cloud-serverless": "^11.4.0",
    "accept-language-parser": "^1.5.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "he": "^1.2.0",
    "http-proxy-middleware": "^4.2.0",
    "sanitize-filename": "^1.6.4"
  },
  "devDependencies": {
    "@types/accept-language-parser": "^1.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/he": "^1.2.3",
    "@types/http-proxy": "^1.17.17",
    "@types/http-server": "^0.12.4",
    "foreman": "^3.0.1",
    "http-proxy": "^1.18.1",
    "http-server": "^14.1.1",
    "node-mocks-http": "^1.18.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents": false
  }
}
